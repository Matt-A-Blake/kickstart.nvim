# clangd configuration template
# Copy this file to your project root as `.clangd` and customize as needed
#
# This file helps clangd find system headers and configure compilation flags
# when compile_commands.json is missing or incomplete.

CompileFlags:
  # C++ standard version (adjust as needed: c++11, c++14, c++17, c++20, c++23)
  Add: 
    - -std=c++17
    
  # System include paths for standard library headers
  # These paths are for Ubuntu/Debian systems with GCC 11
  # Adjust these paths based on your system and compiler version
  # To find your system's include paths, run:
  #   g++ -E -x c++ - -v < /dev/null 2>&1 | grep -A 10 "^#include <...> search starts here:"
    - -I/usr/include/c++/11
    - -I/usr/include/x86_64-linux-gnu/c++/11
    - -I/usr/include/c++/11/backward
    - -I/usr/lib/gcc/x86_64-linux-gnu/11/include
    - -I/usr/local/include
    - -I/usr/include/x86_64-linux-gnu
    - -I/usr/include

# Optional: Add project-specific include directories
# CompileFlags:
#   Add:
#     - -I./include
#     - -I./src
#     - -I../shared

# Optional: Disable specific diagnostics
# Diagnostic:
#   UnusedIncludes: None
#   MissingIncludes: None

# Optional: Configure index behavior
# Index:
#   Background: Build

